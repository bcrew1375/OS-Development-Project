{
  "configurations": [
    {
      "name": "QEMU i386 remote (:1234)",
      "type": "lldb-dap",
      "request": "attach",
      "program": "${workspaceFolder}/zig-out/bin/kernel.elf",
      "gdb-remote-port": 1234,
      "initCommands": [
        "target symbols add ${workspaceFolder}/zig-out/bin/kernel.elf --address 0xC0207000"
      ],

      "preLaunchTask": "Run QEMU",
      "postDebugTask": "Kill QEMU"
    }
  ]
}