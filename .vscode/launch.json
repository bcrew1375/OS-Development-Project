{
  "configurations": [
    {
      "name": "QEMU i386 remote (:1234)",
      "type": "gdb",
      "request": "attach",
      "executable": "${workspaceFolder}/zig build run",
      "cwd": "${workspaceFolder}",
      "gdbpath": "/usr/bin/gdb-multiarch",
      "target": ":1234",
      "remote": true,
      "autorun": [
        //"set architecture i386",
        "add-symbol-file ${workspaceFolder}/zig-out/bin/kernel.elf 0xC0207000"
      ],
      "preLaunchTask": "Run QEMU",
      "postDebugTask": "Kill QEMU"
    }
  ]
}
