      // ],

      // "preLaunchTask": "Run QEMU",
      // "postDebugTask": "Kill QEMU"
      "name": "QEMU i386 remote (:1234)",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/zig-out/bin/kernel.elf",
      "targetCreateCommands": [
        "target create ${workspaceFolder}/zig-out/bin/kernel.elf",
        "target modules load --file ${workspaceFolder}/zig-out/bin/kernel.elf .text 0xC0205000"
      ],
      //"debugServer": 1234,
      "processCreateCommands": [
        "gdb-remote 1234",
        "settings set plugin.process.gdb-remote.packet-timeout 2"
      ],
      "preLaunchTask": "Run QEMU",
      "postDebugTask": "Kill QEMU",
      "initCommands": [
        "process handle SIGTRAP --stop false --pass true --notify false",
      ],
    }
  ]
}