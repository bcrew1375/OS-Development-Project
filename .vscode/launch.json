{
  "configurations": [
    {
      "name": "Kernel Debug (x86-32)",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/zig-out/x86_32/bin/kernel.elf",
      "targetCreateCommands": [
        "target create ${workspaceFolder}/zig-out/x86_32/bin/kernel.elf",
        "target modules add ${workspaceFolder}/zig-out/x86_32/bin/root_process.elf",
      ],
      "processCreateCommands": [
        "gdb-remote 1234",
        "continue"
      ],
      "stopOnEntry": false,
      "preLaunchTask": "Run QEMU (x86-32)",
      "postDebugTask": "Kill QEMU",
      "exitCommands": [
        "quit"
      ]
    },
    {
      "name": "Kernel Debug (x86-64)",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/zig-out/x86_64/bin/kernel.elf",
      "targetCreateCommands": [
        "target create ${workspaceFolder}/zig-out/x86_64/bin/kernel.elf",
        "target modules add ${workspaceFolder}/zig-out/x86_64/bin/root_process.elf",
      ],
      "processCreateCommands": [
        "gdb-remote 1234",
        "continue"
      ],
      "stopOnEntry": false,
      "preLaunchTask": "Run QEMU (x86-64)",
      "postDebugTask": "Kill QEMU",
      "exitCommands": [
        "quit"
      ]
    }
  ]
}