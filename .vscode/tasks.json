    {
      "label": "Run QEMU",
      "type": "shell",
      "command": "zig build debug",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "line": 1,
              "column": 1,
              "message": 1
            }
          ],
          "background": {
            "activeOnStart": false,
            "beginsPattern": { "regexp": "^QEMU Starting$" },
            "endsPattern": { "regexp": "^QEMU Ready$" },
          }
        }
      ],
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "revealProblems": "onProblem",
        "clear": true,
        "close": true,
      },
    },
