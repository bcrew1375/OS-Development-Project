{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Debug Kernel",
      "type": "shell",
      "command": "zig build debug",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "line": 1,
              "column": 1,
              "message": 1
            }
          ],
          "background": {
            // Treat "task started" as soon as the shell launches QEMU.
            "activeOnStart": true,
            "beginsPattern": { "regexp": "." },
            "endsPattern": { "regexp": "^QEMU Ready$" }, //"^.*Listening on.*:1234.*$"
          }
        }
      ],
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "clear": true,
        "close": true
      },
    },
