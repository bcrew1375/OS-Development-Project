    {
      "label": "Kill QEMU",
      "type": "shell",
      "linux": { "command" : "pkill -F .qemu.pid" },
      "windows": { "command": "if (Test-Path .qemu.pid) { Stop-Process -Id (Get-Content .qemu.pid) -Force -ErrorAction SilentlyContinue; Remove-Item .qemu.pid }"},
      "command": "",
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true,
        "close": true
      },
    }
  ],
