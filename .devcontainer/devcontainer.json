{
  "name": "Kernel Debug",
  "dockerComposeFile": "compose.yaml",
  "service": "os-dev",
  "workspaceFolder": "/workspace",
  "forwardPorts": [6000],
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "google.geminicodeassist",
        "vadimcn.vscode-lldb",
        "ziglang.vscode-zig",
        "13xforever.language-x86-64-assembly",
        "${containerWorkspaceFolder}/.devcontainer/extensions/qemu-vnc-0.1.9.vsix",
        "saoudrizwan.claude-dev"
      ],
      "settings": {
        "lldb.launch.initCommands": [
            "command script import /opt/zig/lldb_pretty_printers.py",
            "type category enable zig",
            "type category enable zig.std",
            "type category enable zig.lang",
            "type category enable zig.stage2"
        ],
        "files.watcherExclude": {
          "**/.zig-cache/**": true,
          "**/zig-out/**": true,
          "**/.git/**": true
        },
        "files.useExperimentalFileWatcher": false
      }
    }
  }
}
